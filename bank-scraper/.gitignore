# פרטי התחברות לבנק. הקבצים האלה נוצרים ריקים בהרצה הראשונה ומתמלאים במחשב
# של הלקוח בלבד. אסור בשום מצב שייכנסו ל-git.
secrets/

# תשתית שהסקרייפר מתקין לעצמו בהרצה הראשונה (Node פרטי, Chromium, מטמון npm)
# ופרופילי הדפדפן שמאפשרים לבנק לזהות "מחשב מוכר". מאות מגה-בייט, נוצר מחדש
# לבד, ומשתנה בכל הרצה.
runtime/
node_modules/

# הפלט של המשיכה עצמה - תנועות בנק אמיתיות.
out/

# scrape-banks.js נוצר אוטומטית מתוך bank-scraper-portable.ps1 בכל הרצה.
# הקוד האמיתי נמצא ב-PS1, וזה עותק גזור ממנו - שמירתו ב-git רק הייתה יוצרת
# שתי גרסאות שנפרדות זו מזו.
scrape-banks.js
בדיקות/testable.js
