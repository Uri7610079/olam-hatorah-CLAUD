{
  "crons": [
    {
      "path": "/api/bank-sync",
      "schedule": "0 1 * * *"
    }
  ],
  "functions": {
    "api/talmud-pull.js": {
      "maxDuration": 60,
      "regions": [
        "fra1"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
